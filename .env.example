# FactuAI Environment Configuration Template
# Copy this file to .env and fill in your API keys
# Generated: 2025-12-14 (V4.0.3)

# =============================================================================
# APPLICATION MODE
# =============================================================================
APP_RUN_MODE=cloud

# =============================================================================
# LLM CONFIGURATION (OpenRouter - Default)
# =============================================================================
# Provider selection: "openrouter" (recommended) or "nvidia"
LLM_PROVIDER=openrouter

# OpenRouter Configuration
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# NVIDIA NIM Configuration (Alternative)
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-xxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI-compatible client configuration (used by backend)
# These are auto-derived but can be overridden
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Note: Backend requires asyncpg driver for async SQLAlchemy
# Default aligns with docker-compose.yml (host port 5433)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/factuai
DB_URI=postgresql://postgres:postgres@localhost/factuai
DB_REQUIRED=false
DB_RUN_MIGRATIONS=true

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# =============================================================================
# SEARCH PROVIDERS
# =============================================================================
# Google Custom Search
# https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CX_ID=

# NewsAPI - https://newsapi.org/
NEWSAPI_API_KEY=

# Tavily Search - https://tavily.com/
TAVILY_API_KEY=

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# =============================================================================
# PATHS (Optional - for local model/data storage)
# =============================================================================
MODELS_ROOT=
DATA_ROOT=

# =============================================================================
# FRONTEND
# =============================================================================
FRONTEND_URL=http://localhost:3000

# =============================================================================
# EMBEDDINGS (Infinity - Self-hosted via docker-compose)
# =============================================================================
# Local embedding service for Continuous Learning / RAG
# Use localhost:7997 when running backend on host (development)
# Use embeddings:7997 when running backend inside Docker (production)
# Note: Infinity API doesn't use /v1 prefix - OpenAI client adds /embeddings
EMBEDDING_API_BASE_URL=http://localhost:7997
EMBEDDING_API_KEY=factuai-local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# =============================================================================
# PRE-FLIGHT HEALTH CHECKS
# =============================================================================
# When enabled, the /api/analyze endpoint validates infrastructure connectivity
# (Database, Redis, Embedding Service) BEFORE executing expensive LLM/Search API calls.
# This prevents spending money on external APIs when downstream services are unavailable.
PREFLIGHT_CHECKS_ENABLED=true

# =============================================================================
# RATE LIMITING
# =============================================================================
# Protect expensive endpoints from abuse and accidental credit drainage.
# Limits are per-client-IP per-minute.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=100

# =============================================================================
# CIRCUIT BREAKER
# =============================================================================
# Circuit breaker protects against cascading failures when external APIs
# (LLM, Search, Embeddings) are experiencing issues.
# 
# When failures exceed the threshold, the circuit "opens" and subsequent
# requests fail fast for the timeout period, then slowly test if the
# service has recovered.

# LLM API circuit breaker (for claim verification)
CIRCUIT_BREAKER_LLM_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_LLM_TIMEOUT_SECONDS=120

# Search API circuit breaker (for Tavily, NewsAPI)
CIRCUIT_BREAKER_SEARCH_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SEARCH_TIMEOUT_SECONDS=60

