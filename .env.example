# Copy to `.env` (repo root) and fill values as needed.

# ------------------------------
# Database (Postgres + pgvector)
# ------------------------------
# Default aligns with docker-compose.yml (host port 5433)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/factuai
DB_REQUIRED=false
DB_RUN_MIGRATIONS=true

# -----
# Redis
# -----
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# ------------------------
# LLM (OpenAI-compatible)
# ------------------------
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

LLM_PROVIDER=nvidia
OPENROUTER_MODEL=anthropic/claude-3-haiku
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# -----------------------------
# Embeddings (Learning / RAG)
# -----------------------------
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
LEARNING_CONFIDENCE_THRESHOLD=0.85
LEARNING_MAX_EVIDENCE=8

# ------------------------------
# Search Providers (Pluggable)
# ------------------------------
SEARCH_PROVIDER_PATHS=app.features.search.providers.tavily.TavilySearchProvider,app.features.search.providers.newsapi.NewsApiSearchProvider
TAVILY_API_KEY=
NEWSAPI_API_KEY=
EVIDENCE_CACHE_TTL_SECONDS=1800
