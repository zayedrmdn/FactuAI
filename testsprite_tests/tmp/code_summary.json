{
  "tech_stack": [
    "Python 3.11+",
    "FastAPI",
    "SQLAlchemy (async)",
    "PostgreSQL + pgvector",
    "Redis",
    "TypeScript",
    "Next.js 15",
    "React 19",
    "TailwindCSS 4",
    "Zustand",
    "Radix UI",
    "Framer Motion"
  ],
  "features": [
    {
      "name": "Health Check API",
      "description": "Liveness endpoint to check if the API is running",
      "files": [
        "backend/app/main.py"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/health": {
            "get": {
              "summary": "Health check endpoint",
              "operationId": "health",
              "responses": {
                "200": {
                  "description": "Service is healthy",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "example": "ok"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Analyze API",
      "description": "Multi-claim fact-checking analysis endpoint. Extracts claims from text, gathers evidence from search providers, and verifies claims using LLM.",
      "files": [
        "backend/app/features/analyze/router.py",
        "backend/app/features/analyze/schemas.py",
        "backend/app/features/analyze/service.py"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/analyze": {
            "post": {
              "summary": "Analyze text for fact-checking",
              "operationId": "analyze",
              "tags": [
                "analyze"
              ],
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": [
                        "text"
                      ],
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 5,
                          "maxLength": 5000,
                          "description": "Text to analyze for claims"
                        },
                        "provider": {
                          "type": "string",
                          "enum": [
                            "openrouter",
                            "nvidia"
                          ],
                          "default": "nvidia",
                          "description": "LLM provider to use"
                        },
                        "max_claims": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 8,
                          "default": 3,
                          "description": "Maximum number of claims to extract"
                        },
                        "enable_web_search": {
                          "type": "boolean",
                          "default": true,
                          "description": "Enable web search for evidence"
                        },
                        "enable_kb": {
                          "type": "boolean",
                          "default": true,
                          "description": "Enable knowledge base lookup"
                        }
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Analysis results",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "request_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "model_used": {
                            "type": "string"
                          },
                          "latency_ms": {
                            "type": "integer"
                          },
                          "claims": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "claim_text": {
                                  "type": "string"
                                },
                                "verdict": {
                                  "type": "string",
                                  "enum": [
                                    "true",
                                    "false",
                                    "mostly_true",
                                    "mostly_false",
                                    "mixed",
                                    "unverifiable"
                                  ]
                                },
                                "confidence": {
                                  "type": "number"
                                },
                                "reasoning": {
                                  "type": "string"
                                },
                                "evidence": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "snippet": {
                                        "type": "string"
                                      },
                                      "source_url": {
                                        "type": "string",
                                        "format": "uri"
                                      },
                                      "source_title": {
                                        "type": "string"
                                      },
                                      "source_domain": {
                                        "type": "string"
                                      },
                                      "relevance_score": {
                                        "type": "number"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "400": {
                  "description": "Bad request",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "detail": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "500": {
                  "description": "Internal server error",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "detail": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Login API",
      "description": "User authentication endpoint for login",
      "files": [
        "backend/app/features/auth/router.py",
        "backend/app/features/auth/service.py",
        "backend/app/contracts/auth.py"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/login": {
            "post": {
              "summary": "User login",
              "operationId": "login",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": [
                        "email",
                        "password"
                      ],
                      "properties": {
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "password": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Login successful",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "user": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "email": {
                                "type": "string"
                              },
                              "username": {
                                "type": "string",
                                "nullable": true
                              },
                              "is_active": {
                                "type": "boolean"
                              }
                            }
                          },
                          "message": {
                            "type": "string",
                            "default": "Login successful"
                          }
                        }
                      }
                    }
                  }
                },
                "401": {
                  "description": "Invalid credentials"
                },
                "503": {
                  "description": "Database unavailable"
                }
              }
            }
          }
        }
      }
    },
