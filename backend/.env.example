# FactuAI Backend Environment Configuration Template
# Copy this file to .env and fill in your API keys
# Generated: 2025-12-14 (V4.0.3)

# =============================================================================
# APPLICATION MODE
# =============================================================================
APP_RUN_MODE=cloud

# =============================================================================
# LLM CONFIGURATION (OpenRouter - Default)
# =============================================================================
# Provider selection: "openrouter" (recommended) or "nvidia"
LLM_PROVIDER=openrouter

# OpenRouter Configuration
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# NVIDIA NIM Configuration (Alternative)
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-xxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI-compatible client configuration (used by backend)
# These are auto-derived but can be overridden
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Note: Backend requires asyncpg driver for async SQLAlchemy
# Default aligns with docker-compose.yml (host port 5433)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/factuai
DB_URI=postgresql://postgres:postgres@localhost/factuai
DB_REQUIRED=false
DB_RUN_MIGRATIONS=true

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# =============================================================================
# SEARCH PROVIDERS
# =============================================================================
# Google Custom Search
# https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CX_ID=

# NewsAPI - https://newsapi.org/
NEWSAPI_API_KEY=

# Tavily Search - https://tavily.com/
TAVILY_API_KEY=

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# =============================================================================
# PATHS (Optional - for local model/data storage)
# =============================================================================
MODELS_ROOT=
DATA_ROOT=

# =============================================================================
# FRONTEND
# =============================================================================
FRONTEND_URL=http://localhost:3000

# =============================================================================
# EMBEDDINGS (Infinity - Self-hosted via docker-compose)
# =============================================================================
# Local embedding service for Continuous Learning / RAG
# Uses Docker service name when running in docker-compose network
EMBEDDING_API_BASE_URL=http://embeddings:7997/v1
EMBEDDING_API_KEY=factuai-local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
LEARNING_CONFIDENCE_THRESHOLD=0.85
LEARNING_MAX_EVIDENCE=8

# =============================================================================
# VERIFICATION CONFIG
# =============================================================================
TOKEN_ESTIMATE_RATIO=3.0
LLM_MAX_TOKENS_BASE=800
LLM_MAX_TOKENS_BUFFER=500
LLM_MAX_TOKENS_MAX=4000
LLM_MAX_TOKENS_REASONING_BASE=2000

# =============================================================================
# EVIDENCE CACHE
# =============================================================================
EVIDENCE_CACHE_TTL_SECONDS=1800
