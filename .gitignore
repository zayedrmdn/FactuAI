# Ignore VSCode settings (optional)
.vscode/

# Ignore raw, processed, and tokenized data
data/raw/
data/processed/
data/tokenized/

# Ignore logs
logs/

# Ignore Unsloth compiled cache
unsloth_compiled_cache/

# Ignore user uploads
backend/uploads/

# Ignore frontend build artifacts and dependencies
frontend/.next/
frontend/node_modules/

